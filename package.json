{
  "name": "hegosentinel",
  "version": "0.1.0-alpha.4",
  "private": true,
  "description": "Developer-first, self-hosted security assessment, evidence normalization, remediation, and re-test workflow.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "packages/*",
    "integrations/*"
  ],
  "bin": {
    "hegosentinel": "./packages/scanner-core/src/cli.ts"
  },
  "scripts": {
    "hegosentinel": "node --experimental-strip-types ./packages/scanner-core/src/cli.ts",
    "serve": "node --experimental-strip-types ./packages/scanner-core/src/server.ts",
    "demo": "node --experimental-strip-types ./packages/scanner-core/src/cli.ts demo --offline",
    "demo:patched": "node --experimental-strip-types ./packages/scanner-core/src/cli.ts demo --offline --fixture patched",
    "scan": "node --experimental-strip-types ./packages/scanner-core/src/cli.ts scan",
    "compare": "node --experimental-strip-types ./packages/scanner-core/src/cli.ts compare",
    "lint": "node --experimental-strip-types ./scripts/lint-and-typecheck.ts --lint",
    "typecheck": "node ./node_modules/typescript/lib/tsc.js -p tsconfig.json --noEmit && node ./node_modules/typescript/lib/tsc.js -p apps/web/tsconfig.json --noEmit && node --experimental-strip-types ./scripts/lint-and-typecheck.ts --typecheck",
    "test:unit": "node --experimental-strip-types --test ./tests/unit/checks-and-recheck.test.ts",
    "test:security": "node --experimental-strip-types --test ./tests/security/security-matrix.test.ts ./tests/security/audit-regression.test.ts ./tests/security/independent-boundary-audit.test.ts ./tests/security/cookie-csp-identity-regression.test.ts ./tests/security/worker-containment-and-sprint2.test.ts ./tests/security/broker-b2-regression.test.ts ./tests/security/worker-supervisor-isolation.test.ts",
    "test:integration": "node --experimental-strip-types --test ./tests/integration/adapters-and-reports.test.ts",
    "test:e2e": "node --experimental-strip-types --test ./tests/e2e/cli-demo.test.ts ./tests/e2e/web-api-platform.test.ts",
    "test:api": "php apps/api/tests/run-api-tests.php && php apps/api/tests/run-security-regression-tests.php && php apps/api/tests/run-laravel11-kernel-tests.php",
    "test:postgres-rls": "php -d extension=pdo_pgsql -d extension=pgsql apps/api/tests/run-postgres-rls-tests.php",
    "start:api": "php apps/api/artisan serve --host=127.0.0.1 --port=8000",
    "start:web": "npm --prefix apps/web run start",
    "build:web": "npm --prefix apps/web run build",
    "test": "node --experimental-strip-types --test ./tests/unit/checks-and-recheck.test.ts ./tests/security/security-matrix.test.ts ./tests/security/audit-regression.test.ts ./tests/integration/adapters-and-reports.test.ts ./tests/e2e/cli-demo.test.ts ./tests/e2e/web-api-platform.test.ts ./tests/security/independent-boundary-audit.test.ts ./tests/security/cookie-csp-identity-regression.test.ts ./tests/security/worker-containment-and-sprint2.test.ts ./tests/security/broker-b2-regression.test.ts ./tests/security/worker-supervisor-isolation.test.ts",
    "docs:links": "node --experimental-strip-types ./scripts/check-markdown-links.ts",
    "verify:gates": "node --experimental-strip-types ./scripts/verify-all-security-gates.ts",
    "verify:release-gate": "node --experimental-strip-types ./scripts/release-gate-check.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
