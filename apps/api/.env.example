APP_NAME="HegoSentinel API"
APP_ENV=local
APP_KEY=base64:SGVnb1NlbnRpbmVsU3ByaW50OEFwaUtleTIwMjZTZWN1cmU=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
FRONTEND_URL=http://127.0.0.1:3000

# Database: use pgsql in Docker Compose / Production, sqlite for zero-dependency local dev
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=hegosentinel
DB_USERNAME=hegosentinel
DB_PASSWORD=hegosentinel_local_dev_only

# Queue & Horizon
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379

# Trusted Egress Broker & Worker Isolation
HEGOSENTINEL_EGRESS_BROKER_URL=http://egress-broker:8790
HEGOSENTINEL_RESTRICTED_REMOTE_ENABLED=false

