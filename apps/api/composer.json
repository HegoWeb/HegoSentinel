{
  "name": "hegoweb/hegosentinel-api",
  "type": "project",
  "description": "HegoSentinel Stage 2 Multi-Tenant Security Assessment & Remediation API (Laravel 11 + PostgreSQL + Redis Horizon)",
  "keywords": ["hegosentinel", "security", "laravel", "sast", "sca", "rbac"],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-pdo": "*",
    "ext-json": "*",
    "ext-openssl": "*",
    "laravel/framework": "^11.30",
    "laravel/horizon": "^5.29",
    "laravel/sanctum": "^4.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}

