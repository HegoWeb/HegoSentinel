{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hegosentinel.dev/schemas/recheck/v1.0.0.json",
  "title": "HegoSentinelRecheckComparison",
  "description": "Deterministic re-test comparison schema distinguishing no_longer_observed, verified_fixed, and not_comparable (S1-05 / HSR-05).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_scan_id",
    "current_scan_id",
    "organization_id",
    "project_id",
    "comparable",
    "incomparability_reasons",
    "compared_at",
    "counts",
    "items"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "baseline_scan_id": { "type": "string", "minLength": 1 },
    "current_scan_id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "comparable": { "type": "boolean" },
    "incomparability_reasons": {
      "type": "array",
      "items": { "type": "string" }
    },
    "compared_at": { "type": "string", "format": "date-time" },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new",
        "persistent",
        "no_longer_observed",
        "verified_fixed",
        "reopened",
        "not_comparable",
        "skipped",
        "false_positive"
      ],
      "properties": {
        "new": { "type": "integer", "minimum": 0 },
        "persistent": { "type": "integer", "minimum": 0 },
        "no_longer_observed": { "type": "integer", "minimum": 0 },
        "verified_fixed": { "type": "integer", "minimum": 0 },
        "reopened": { "type": "integer", "minimum": 0 },
        "not_comparable": { "type": "integer", "minimum": 0 },
        "skipped": { "type": "integer", "minimum": 0 },
        "false_positive": { "type": "integer", "minimum": 0 }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fingerprint",
          "rule_id",
          "asset_key",
          "title",
          "previous_state",
          "recheck_state",
          "explanation"
        ],
        "properties": {
          "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "rule_id": { "type": "string", "minLength": 1 },
          "asset_key": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "previous_state": { "type": "string", "minLength": 1 },
          "recheck_state": {
            "type": "string",
            "enum": [
              "new",
              "persistent",
              "no_longer_observed",
              "verified_fixed",
              "reopened",
              "not_comparable",
              "skipped",
              "false_positive"
            ]
          },
          "explanation": { "type": "string", "minLength": 1 },
          "suppression": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reviewer", "reason", "expires_at"],
            "properties": {
              "reviewer": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "expires_at": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    }
  }
}

